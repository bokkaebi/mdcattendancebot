# Singpass credentials (REQUIRED) — populate .env, never commit it
SINGPASS_ID=
SINGPASS_PASSWORD=

# OTP HTTP bridge (optional — defaults shown; only used with --http-otp)
OTP_HOST=127.0.0.1
OTP_PORT=8080

# Target form (optional — defaults to the attendance form)
FORM_URL=https://form.gov.sg/6818179de1b7fe5377eb5c20

# Settle delay (ms) after returning to the authenticated form, before saving
# HTML (--discover) or filling. The form is a React SPA that keeps rendering
# after networkidle; bump this if --discover captures an incomplete form.
FORM_SETTLE_MS=3000

# Browser (optional — empty uses Playwright's bundled Chromium)
# Runs are headless by default; set false or pass --headed to either entry point.
HEADLESS=true
# CHROMIUM_EXECUTABLE_PATH=/usr/bin/chromium

# Telegram bot (optional — only used by `mdcattendance-tg`)
# Bot token from @BotFather. Empty disables the Telegram entry point.
TELEGRAM_BOT_TOKEN=
# Path to per-user Singpass credentials (gitignored; see users.example.json).
# Each record maps a Telegram user id to singpass_id / singpass_password / department.
TELEGRAM_USERS_PATH=users.json
# Path to per-user schedules (gitignored).
TELEGRAM_SCHEDULES_PATH=schedules.json
# Max parallel Chromium runs (one per attendance run). Lower if the machine OOMs.
MAX_CONCURRENT_RUNS=2
# Seconds to wait for each in-chat text / OTP / clinic / timing prompt.
PROMPT_TIMEOUT=600

# Unauthenticated per-chat OTP receiver for `mdcattendance-tg`.
# Restrict network access with Tailscale; bind to its IPv4 address when possible.
TELEGRAM_OTP_HOST=0.0.0.0
TELEGRAM_OTP_PORT=8080
# Phone JSON body: {"chat_id": 123456789, "otp": "123456"}
