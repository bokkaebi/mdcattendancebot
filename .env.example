# Copy to a mode-0600 file; never commit populated credentials.
# MDCATTENDANCE_ENV_FILE selects that restricted file (set outside the file).
# CLI submit/dry-run needs these; preflight does not.
SINGPASS_ID=
SINGPASS_PASSWORD=
FORM_URL=https://form.gov.sg/6818179de1b7fe5377eb5c20

# Bundled Chromium, headless and sandboxed; no desktop required.
HEADLESS=true
# CHROMIUM_EXECUTABLE_PATH=/usr/bin/chromium
SLOW_MO=0
NAVIGATION_TIMEOUT_MS=60000
FORM_SETTLE_MS=3000
OTP_TIMEOUT=180

# Optional loopback-only HTTP OTP receiver; off by default (manual OTP still works).
# OTP_HTTP_ENABLED alone starts it, even before any owner has a token; per-owner
# Telegram tokens are re-read from the restricted users file on each request
# (blank/omitted token = that owner stays manual and gets 401).
OTP_HTTP_ENABLED=false
OTP_HTTP_PORT=8765
# CLI-only bearer secret; generate locally. Telegram ignores it and uses each
# owner's users.json otp_token; this variable never gates the running receiver.
OTP_HTTP_TOKEN=
RUN_TIMEOUT=600

# SQLite attempts journal, planner tables and process lock. Directory must be private (0700).
STATE_DIR=state
ATTENDANCE_DEADLINE=09:00
RETENTION_DAYS=90
# Explicit discovery artifacts only; routine screenshots/traces/video are disabled.
DIAGNOSTIC_TTL_HOURS=24

# Telegram long polling; users file is the locally provisioned private allowlist.
TELEGRAM_BOT_TOKEN=
TELEGRAM_USERS_PATH=users.json
PROMPT_TIMEOUT=600

# Telegram Mini App planner, served in the same process. Blank MINIAPP_PUBLIC_URL
# disables it; when set it must be the bare assigned HTTPS origin only (no path,
# query, fragment or credentials). The assigned ngrok domain forwards to this
# loopback gateway; its exact /otp and /otp/pending routes proxy to the separate
# OTP receiver above, which OTP_HTTP_ENABLED controls independently — the gateway
# never starts it, and those routes return 503 while it is off.
MINIAPP_PUBLIC_URL=
MINIAPP_PORT=8766
